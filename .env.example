# Somente GitHub Actions Secrets. Nunca coloque prefixo VITE_ nestes valores.
FOREASY_EMAIL=
FOREASY_PASSWORD=
# Gere com: openssl rand -base64 32
FOREASY_TOKEN_KEY=
# Identificador numérico privado do prédio da conta.
FOREASY_BUILDING_ID=
# Array privado de máquinas, IDs e permissão validados (exemplo fictício no README).
FOREASY_MACHINE_CONFIG=[]
# Repository Variables, sem identificação pessoal:
FOREASY_CONTRACT=unverified
FOREASY_MAX_CALLS=40
FOREASY_PROBE_DATE_OFFSET=0
FOREASY_PROBE_TIME=09:00
# Única configuração VITE_: caminho público do Pages.
VITE_BASE_PATH=./
